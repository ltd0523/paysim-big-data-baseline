+                    for metric in ['Precision', 'Recall', 'F1'])
+    base = alt.Chart(pd.DataFrame(rows)).encode(
+        y=alt.Y('Metric:N', title=None, sort=['Precision', 'Recall', 'F1'], axis=alt.Axis(grid=False)),
